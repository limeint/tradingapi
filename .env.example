# Shared settings for every example in this repository.
#
# Copy this file to .env in the repository root, replace the placeholders, and
# run the examples through `just`. Every recipe loads the root .env
# automatically:
#
#   cp .env.example .env
#   just env-status
#   just run-strategy-python sma_crossover --check
#
# .env is gitignored; never commit a real secret. Variables already exported in
# your shell take precedence over this file.

# Trade API secret issued by Limeint. Every example requires it.
TRADE_API_SECRET=tapi_sk_replace_me

# Symbol in ticker@mic form. The Trade API resolves against segment MICs, so a
# Nasdaq listing uses XNGS rather than the operating MIC XNAS.
TRADE_API_SYMBOL=AAPL@XNGS

# Strategy settings. Supported timeframes are M1, M5, M15, M30, H1, H2, H4, H8,
# D, W, MN, and QR.
TRADE_API_TIMEFRAME=M5
TRADE_API_QUANTITY=1
TRADE_API_LOG_LEVEL=INFO

# Limit-order examples only, and deliberately left unset. Those examples submit
# a real order; they refuse to run until you set an intended limit price and
# acknowledge execution.
# TRADE_API_LIMIT_PRICE=
# TRADE_API_EXECUTE=1
