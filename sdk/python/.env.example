# Copy to .env (gitignored) and fill in real values before running the examples.
#
#   cp .env.example .env
#   # edit .env
#   set -a && source .env && set +a
#   uv run python examples/auth_and_account.py

# API secret issued by the Trade API provider (looks like: tapi_sk_XXXXXXXXXXXXXXXXXXXX).
# Treat as a password — never commit, never paste into chat/issues.
TRADE_API_SECRET=tapi_sk_replace_me
