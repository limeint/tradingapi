# Copy to .env (gitignored) and fill in real values before running the examples.
#
#   cp .env.example .env
#   # edit .env
#   set -a && source .env && set +a
#   python examples/auth_and_account.py

# API secret issued by the Trade API provider (looks like: tapi_sk_XXXXXXXXXXXXXXXXXXXX).
# Treat as a password — never commit, never paste into chat/issues.
TRADE_API_SECRET=tapi_sk_replace_me

# A real trading account number visible to TRADE_API_SECRET.
# Discover yours by running:
#   python -c "from trade_api import TradeAPIClient; \
#              from trade_api.proto.grpc.tradeapi.v1.auth.auth_service_pb2 import TokenDetailsRequest; \
#              c=TradeAPIClient(secret='\$TRADE_API_SECRET'); \
#              print(list(c.auth.TokenDetails(TokenDetailsRequest(token=c.token)).account_ids))"
TRADE_API_ACCOUNT_ID=1234567
